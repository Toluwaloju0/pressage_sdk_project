# Copy to .env and fill in. Never commit .env.
# Only variables that start with VITE_ are sent to the browser.

# There is NO server-wide Presage key. Each person creates a free Presage account
# (https://physiology.presagetech.com/auth/register) and pastes their own API key on the
# Account page. It is kept in their browser and sent to the scan service only when a scan starts.

# Presage usage telemetry is off unless you set this to true.
SMARTSPECTRA_TELEMETRY=false

# Presage LLM insight, shown to the person after a scan (and printed to the scan service's terminal).
# How long to wait for the answer (milliseconds), and the shortest scan that asks for one (seconds).
INSIGHT_TIMEOUT_MS=20000
INSIGHT_MIN_SECONDS=15

# Scan service (sdk-service/): the Node process that runs the SDK.
SDK_SERVICE_PORT=8787
# Longest a single scan may run, in seconds (10 to 300).
SCAN_MAX_SECONDS=60
# Scans that may run at the same time, service-wide (1 to 10). The SDK keeps process-wide state, so keep 1.
MAX_CONCURRENT_SCANS=1
# Page origins allowed to open the scan connection (comma separated).
ALLOWED_ORIGINS=http://localhost:5173
